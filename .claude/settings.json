{
  "permissions": {
    "allow": [
      "Bash(uv:*)", "Bash(uv run:*)", "Bash(pytest:*)", "Bash(ruff:*)", "Bash(mypy:*)",
      "Bash(pre-commit:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git checkout -b:*)", "Bash(git switch:*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push origin main:*)",
      "Bash(git reset --hard:*)", "Bash(rm -rf:*)",
      "Bash(gh release:*)", "Bash(gh secret:*)", "Bash(gh api --method DELETE:*)",
      "Read(**/.envrc)", "Read(**/.env)"
    ]
  }
}
